{
  "name": "solar-sky-radar",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "Home Assistant HACS integration and Lovelace weather radar card with Himawari-9/global true-colour & solar cloud overlays, wind streamlines, lightning, NASA FIRMS, and 2-hour jogging playback.",
  "scripts": {
    "build": "vite build",
    "build:card": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:frontend": "vitest run",
    "preview:server": ".venv/bin/python dev/preview_server.py",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "lit": "^3.2.1",
    "maplibre-gl": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
